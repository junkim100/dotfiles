# Taps
# brew bundle taps before it installs casks, so these stay first. Orca ships only through its vendor tap.
tap "stablyai/orca"
# This repository is also a tap: Casks/ carries the GlobalProtect cask that Homebrew itself does not offer.
tap "junkim100/dotfiles", "https://github.com/junkim100/dotfiles.git"

# Fonts
cask "font-fira-code-nerd-font"
cask "font-meslo-lg-nerd-font"

# Applications
cask "antinote"
cask "arc"
cask "claude"
cask "ghostty"
# From this repository's own tap, see Casks/globalprotect.rb.
cask "globalprotect"
cask "google-chrome"
cask "google-drive"
cask "obsidian"
cask "stablyai/orca/orca"
cask "pearcleaner"
cask "slack"
cask "spotify"
cask "stats"
cask "tailscale-app"
cask "logi-options+"

# CLI Tools
brew "bat"
# fastfetch stands in for neofetch, which Homebrew disabled on 2025-05-04 once its upstream was archived.
# Leaving neofetch here aborts the whole installer, because brew bundle exits non-zero under set -eu.
brew "fastfetch"
brew "fd"
brew "gh"
# Required by claude-code/statusline-command.sh for the model and token segments.
brew "jq"
brew "lazygit"
brew "oh-my-posh"
brew "ranger"
brew "ripgrep"
brew "tmux"
brew "tree"
# Backs the tmux URL picker bound to prefix + u in common/tmux/tmux.conf.
brew "urlview"
brew "uv"
brew "watch"
brew "yt-dlp"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Neovim is deliberately absent because lazyvim/install.sh installs a pinned, checksum-verified build into ~/.local/bin.

# Media and documents
brew "ffmpeg"

# Development
brew "hf"

# macOS utilities
brew "cliclick"
brew "displayplacer"
brew "nowplaying-cli"

# Other
brew "gogcli"

# Mac App Store
# These apps are installed from the App Store, so mas drives the App Store instead of a cask.
# Hidden Bar also has a cask, but the copy on the current Mac carries an App Store receipt,
# and a cask install fails when an app it did not install already sits in /Applications.
# mas only installs apps already purchased under the Apple ID signed into the App Store,
# so sign in there before running brew bundle on a new machine.
# brew "mas" stays in this block rather than the CLI list because brew bundle works through
# the file in order and the mas entries below need the binary to already be present.
brew "mas"
mas "Amphetamine", id: 937984704
mas "Hand Mirror", id: 1502839586
mas "Hidden Bar", id: 1452453066
mas "Magnet", id: 441258766
mas "QuickShade", id: 931571202

# Exceptions
# These apps live on the Mac but are deliberately not managed here. Each has no Homebrew cask or is
# installed by something else, so install them by hand on a new machine.
# - BIG-IP Edge Client and F5 Endpoint Inspector: F5 VPN client, installed from the organisation's F5 portal pkg.
# - Sindoh MPS Cloud: printer driver, installed from the Sindoh pkg.
# - Exosphere: no cask, installed from the vendor pkg.
# - CuaDriver: installed by the Cua tooling, not by hand.
# - Google Docs, Google Sheets, and Google Slides: shortcuts that Google Drive creates on its own.
# - Claude Code URL Handler in ~/Applications: created by Claude Code on first run.
