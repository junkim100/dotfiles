#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
LINK_FILE="$SCRIPT_DIR/link-file"
TEMP_DIR=$(mktemp -d)
TMUX_SOCKET="dotfiles-check-$$"

cleanup() {
  if command -v tmux >/dev/null 2>&1; then
    tmux -L "$TMUX_SOCKET" kill-server 2>/dev/null || true
  fi
  rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

fail() {
  echo "check failed: $*" >&2
  exit 1
}

check_alias() {
  local path="$DOTFILES_DIR/$1"
  local expected=$2
  [[ -L $path ]] || fail "$1 is not a symlink"
  [[ $(readlink "$path") == "$expected" ]] || fail "$1 points to $(readlink "$path"), expected $expected"
}

check_alias CLAUDE.md AGENTS.md
check_alias .gitconfig common/git/config
check_alias macOS/.tmux.conf ../common/tmux/tmux.conf
check_alias ubuntu/.tmux.conf ../common/tmux/tmux.conf
check_alias macOS/bat/config ../../common/bat/config
check_alias ubuntu/bat/config ../../common/bat/config
check_alias macOS/ranger/rc.conf ../../common/ranger/rc.conf
check_alias ubuntu/ranger/rc.conf ../../common/ranger/rc.conf
check_alias macOS/ghostty-theme-everforest-dark ../common/ghostty/themes/everforest-dark.txt
check_alias claude-code/skills/conference-paper-review ../../agents/skills/conference-paper-review
check_alias claude-code/skills/interview ../../agents/skills/interview
check_alias claude-code/skills/paper-study-notes ../../agents/skills/paper-study-notes
check_alias claude-code/skills/pr ../../agents/skills/pr-review
check_alias claude-code/skills/quiz ../../agents/skills/quiz

for skill in "$DOTFILES_DIR"/claude-code/skills/*; do
  [[ -L $skill ]] || fail "$skill must be a compatibility symlink into agents/skills"
  canonical=$(cd "$skill" && pwd -P)
  [[ $canonical == "$DOTFILES_DIR/agents/skills/"* && -f $canonical/SKILL.md ]] \
    || fail "$skill does not resolve to a canonical skill in agents/skills"
done

# Installers that support --dry-run must run end to end without touching the
# machine. link-file rejects a missing source even under --dry-run, so this
# doubles as proof that every path the installer links from still exists.
check_dry_run() {
  local installer=$1
  local home
  # Verified statically and first: an installer that does not parse --dry-run
  # ignores the flag and runs for real, which is exactly what this must prevent.
  grep -q -- '--dry-run)' "$DOTFILES_DIR/$installer" \
    || fail "$installer has no --dry-run case arm, so it would run for real"
  home=$(mktemp -d "$TEMP_DIR/dry-run-XXXXXX")
  if ! HOME="$home" bash "$DOTFILES_DIR/$installer" --dry-run > "$home.log" 2>&1; then
    cat "$home.log" >&2
    fail "$installer --dry-run exited non-zero"
  fi
  [[ -z $(find "$home" -mindepth 1) ]] || fail "$installer --dry-run modified the home directory"
}

# Installers without --dry-run still get their tracked link sources verified
# statically. Sources that are only known at run time are skipped.
check_link_sources() {
  local installer=$1
  local dir="$DOTFILES_DIR/$(dirname "$installer")"
  local source
  while IFS= read -r source; do
    [[ -z $source || $source == *'$'* ]] && continue
    [[ -e $source ]] || fail "$installer links from a missing source: $source"
  done < <(grep -oE '("\$LINK_FILE"|link_file)[^"]*"[^"]+"' "$DOTFILES_DIR/$installer" \
    | sed -E 's/.*"([^"]+)"$/\1/' \
    | sed -e "s|\$DOTFILES_DIR|$DOTFILES_DIR|g" -e "s|\$SCRIPT_DIR|$dir|g")
}

check_dry_run macOS/install.sh
check_dry_run ubuntu/install.sh

check_link_sources macOS/install.sh
check_link_sources ubuntu/install.sh
check_link_sources common/tmux/install.sh
check_link_sources claude-code/install.sh
check_link_sources agents/install.sh
check_link_sources profiles/backend-ai/install.sh

check_dry_run agents/install.sh

# Exercise Codex installation with isolated tools and a fake download, never the
# network or a real package installation, even on a machine without Codex.
agent_bin="$TEMP_DIR/agent-bin"
agent_home="$TEMP_DIR/agent-home"
mkdir -p "$agent_bin" "$agent_home"
for tool in bash sh dirname basename mkdir readlink ln rm mktemp cat chmod; do
  ln -s "$(command -v "$tool")" "$agent_bin/$tool"
done
cat > "$agent_bin/curl" <<'CURL'
#!/usr/bin/env bash
set -euo pipefail
printf 'download\n' >> "$HOME/downloads"
cat > "${!#}" <<'INSTALLER'
#!/bin/sh
set -eu
printf 'installed\n' >> "$HOME/installer-ran"
[ "$CODEX_NON_INTERACTIVE" = 1 ]
[ "$CODEX_INSTALL_DIR" = "$HOME/.local/bin" ]
case ":$PATH:" in
  *":$CODEX_INSTALL_DIR:"*) ;;
  *) exit 1 ;;
esac
[ "${MOCK_INSTALL_EXIT:-0}" = 0 ] || exit "$MOCK_INSTALL_EXIT"
mkdir -p "$CODEX_INSTALL_DIR"
printf '#!/bin/sh\nprintf "codex-cli test\\n"\n' > "$CODEX_INSTALL_DIR/codex"
chmod +x "$CODEX_INSTALL_DIR/codex"
INSTALLER
exit "${MOCK_CURL_EXIT:-0}"
CURL
chmod +x "$agent_bin/curl"

HOME="$agent_home" PATH="$agent_bin" bash "$DOTFILES_DIR/agents/install.sh" --dry-run > "$TEMP_DIR/agent.log" 2>&1 \
  || { cat "$TEMP_DIR/agent.log"; fail "agent dry-run failed without Codex"; }
[[ -z $(find "$agent_home" -mindepth 1) ]] || fail "agent dry-run downloaded or changed files"
grep -q 'install Codex CLI' "$TEMP_DIR/agent.log" || fail "agent dry-run did not preview Codex installation"
if HOME="$agent_home" PATH="$agent_bin" bash "$DOTFILES_DIR/agents/install.sh" --dry-run --unknown > "$TEMP_DIR/agent.log" 2>&1; then
  fail "agent installer accepted an unknown extra argument"
fi

mkdir -p "$agent_home/.agents/skills/local-skill"
printf 'local skill\n' > "$agent_home/.agents/skills/local-skill/SKILL.md"
for attempt in 1 2; do
  HOME="$agent_home" PATH="$agent_bin" bash "$DOTFILES_DIR/agents/install.sh" > "$TEMP_DIR/agent.log" 2>&1 \
    || { cat "$TEMP_DIR/agent.log"; fail "agent installation attempt $attempt failed"; }
done
[[ -x $agent_home/.local/bin/codex ]] || fail "Codex was not installed"
[[ $(cat "$agent_home/downloads") == download ]] || fail "agent installer downloaded again on rerun"
[[ $(cat "$agent_home/installer-ran") == installed ]] || fail "agent installer reinstalled Codex on rerun"
[[ $(cat "$agent_home/.agents/skills/local-skill/SKILL.md") == 'local skill' ]] || fail "agent installer changed a local skill"
for skill in "$DOTFILES_DIR"/agents/skills/*/; do
  [[ $(readlink "$agent_home/.agents/skills/$(basename "$skill")") == "${skill%/}" ]] \
    || fail "agent installer did not link $skill"
done

existing_home="$TEMP_DIR/agent-existing"
mkdir -p "$existing_home"
HOME="$existing_home" PATH="$agent_home/.local/bin:$agent_bin" bash "$DOTFILES_DIR/agents/install.sh" > "$TEMP_DIR/agent.log" 2>&1 \
  || { cat "$TEMP_DIR/agent.log"; fail "agent installation failed with Codex on PATH"; }
[[ ! -e $existing_home/downloads && ! -e $existing_home/.local ]] || fail "agent installer replaced an existing Codex"

for failure in download install; do
  failed_home="$TEMP_DIR/agent-failed-$failure"
  mkdir -p "$failed_home"
  curl_exit=0
  install_exit=0
  if [[ $failure == download ]]; then curl_exit=22; else install_exit=42; fi
  if HOME="$failed_home" PATH="$agent_bin" MOCK_CURL_EXIT="$curl_exit" MOCK_INSTALL_EXIT="$install_exit" \
    bash "$DOTFILES_DIR/agents/install.sh" > "$TEMP_DIR/agent.log" 2>&1; then
    fail "agent installer ignored a Codex $failure failure"
  fi
  [[ ! -e $failed_home/.local/bin/codex ]] || fail "Codex was installed after a $failure failure"
  if [[ $failure == download ]]; then
    [[ ! -e $failed_home/installer-ran ]] || fail "agent installer executed an incomplete download"
  fi
done

# Sourced fragments carry no shebang, so the shebang-driven loop below skips them.
sh -n "$DOTFILES_DIR/common/shell/aliases.sh"
sh -n "$DOTFILES_DIR/common/shell/autopull.sh"


while IFS= read -r script; do
  case "$(sed -n '1p' "$script")" in
    *bash*) bash -n "$script" ;;
    '#!/bin/sh') sh -n "$script" ;;
  esac
done < <(find "$DOTFILES_DIR" \( -path "$DOTFILES_DIR/.git" -o -path "$DOTFILES_DIR/lazyvim" \) -prune -o -type f -print)

bash -n "$DOTFILES_DIR/ubuntu/.bashrc"
if command -v zsh >/dev/null 2>&1; then
  zsh -n "$DOTFILES_DIR/macOS/.zshrc"
  zsh -n "$DOTFILES_DIR/macOS/.zprofile"
fi
bash -n "$DOTFILES_DIR/profiles/backend-ai/.bashrc"

while IFS= read -r installer; do
  if grep -Eq '\$HOME/dotfiles|~/dotfiles|data00/private/junkim/dotfiles|ubuntu_backend_ai' "$installer"; then
    fail "$installer contains a fixed repository path"
  fi
  if grep -Eq '(^|[[:space:]])ln[[:space:]]+-s' "$installer"; then
    fail "$installer bypasses scripts/link-file"
  fi
done < <(find "$DOTFILES_DIR" \( -path "$DOTFILES_DIR/.git" -o -path "$DOTFILES_DIR/lazyvim" \) -prune -o -type f \( -name 'install.sh' -o -name 'setup*.sh' \) -print)

printf 'old config\n' > "$TEMP_DIR/config"
"$LINK_FILE" "$DOTFILES_DIR/common/tmux/tmux.conf" "$TEMP_DIR/config" >/dev/null
[[ -L $TEMP_DIR/config ]] || fail "link helper did not replace an existing file"
[[ ! -e $TEMP_DIR/config.pre-dotfiles ]] || fail "link helper created a backup"
"$LINK_FILE" "$DOTFILES_DIR/common/tmux/tmux.conf" "$TEMP_DIR/config" >/dev/null
mkdir "$TEMP_DIR/real-directory"
if "$LINK_FILE" "$DOTFILES_DIR/common/tmux/tmux.conf" "$TEMP_DIR/real-directory" >/dev/null 2>&1; then
  fail "link helper replaced a real directory"
fi

"$LINK_FILE" "$DOTFILES_DIR/common/git/config" "$TEMP_DIR/home/.config/git/common" >/dev/null
"$LINK_FILE" "$DOTFILES_DIR/ubuntu/git/config" "$TEMP_DIR/home/.gitconfig" >/dev/null
[[ $(HOME="$TEMP_DIR/home" GIT_CONFIG_NOSYSTEM=1 git config --global --includes --get user.email) == junkim100@gmail.com ]] || fail "shared Git identity is not included"
[[ $(HOME="$TEMP_DIR/home" GIT_CONFIG_NOSYSTEM=1 git config --global --includes --get alias.co) == checkout ]] || fail "shared Git aliases are not included"

if command -v bat >/dev/null 2>&1; then
  bat --config-file "$DOTFILES_DIR/common/bat/config" --diagnostic >/dev/null
fi

if command -v tmux >/dev/null 2>&1; then
  tmux -L "$TMUX_SOCKET" -f "$DOTFILES_DIR/common/tmux/tmux.conf" new-session -d -s verify
  [[ $(tmux -L "$TMUX_SOCKET" show-options -gv prefix) == C-Space ]] || fail "shared tmux prefix is incorrect"
  [[ $(tmux -L "$TMUX_SOCKET" show-options -gv status-position) == top ]] || fail "shared tmux status bar is not at the top"
  [[ $(tmux -L "$TMUX_SOCKET" show-options -gv mouse) == on ]] || fail "shared tmux mouse support is disabled"
  [[ $(tmux -L "$TMUX_SOCKET" show-options -gv renumber-windows) == on ]] || fail "shared tmux window renumbering is disabled"
  [[ $(tmux -L "$TMUX_SOCKET" show-options -gqv @continuum-restore) == on ]] || fail "shared tmux automatic restore is disabled"
  [[ $(tmux -L "$TMUX_SOCKET" show-options -gqv @continuum-boot) == on ]] || fail "shared tmux automatic boot is disabled"
  [[ $(tmux -L "$TMUX_SOCKET" list-keys -T root) =~ M-S-Enter[[:space:]]+split-window[[:space:]]+-h ]] || fail "shared tmux horizontal split binding is missing"
  tmux -L "$TMUX_SOCKET" kill-server
fi

git -C "$DOTFILES_DIR" diff --check

echo "dotfiles check passed"
