#!/bin/bash
python3 - <<'PY'

import configparser
import re
import tomllib
from pathlib import Path

home = Path.home()
colors_path = home / ".local/state/omarchy/current/theme/colors.toml"
profiles_path = home / ".config/zen/profiles.ini"

if not colors_path.is_file() or not profiles_path.is_file():
    raise SystemExit(0)

with colors_path.open("rb") as file:
    colors = tomllib.load(file)

hex_color = re.compile(r"^#[0-9a-fA-F]{6}$")


def color(name: str, fallback: str) -> str:
    value = colors.get(name, fallback)
    return value if isinstance(value, str) and hex_color.fullmatch(value) else fallback


palette = {
    "accent": color("accent", "#7fbbb3"),
    "selection": color("selection", "#3d484d"),
    "background": color("background", "#2d353b"),
    "dark_background": color("dark_background", "#21272c"),
    "darker_background": color("darker_background", "#181d20"),
    "lighter_background": color("lighter_background", "#343f44"),
    "foreground": color("foreground", "#d3c6aa"),
    "muted": color("muted", "#475258"),
}
mode = colors.get("mode", "dark")
theme_name_path = home / ".local/state/omarchy/current/theme.name"
theme_name = theme_name_path.read_text().strip() if theme_name_path.is_file() else "current"

css = f"""/* Generated by the Omarchy theme-set hook. Theme: {theme_name}. */
:root {{
  color-scheme: {mode} !important;
  --zen-primary-color: {palette['accent']} !important;
  --zen-colors-primary: color-mix(in srgb, {palette['background']} 72%, transparent) !important;
  --zen-colors-secondary: color-mix(in srgb, {palette['lighter_background']} 76%, transparent) !important;
  --zen-colors-tertiary: color-mix(in srgb, {palette['dark_background']} 78%, transparent) !important;
  --zen-colors-border: color-mix(in srgb, {palette['accent']} 24%, transparent) !important;
  --zen-main-browser-background: transparent !important;
  --zen-main-browser-background-toolbar: transparent !important;
  --zen-main-browser-background-old: transparent !important;
  --zen-main-browser-background-toolbar-old: transparent !important;
  --zen-navigator-toolbox-background: transparent !important;
  --zen-themed-toolbar-bg: color-mix(in srgb, {palette['background']} 68%, transparent) !important;
  --zen-themed-toolbar-bg-transparent: color-mix(in srgb, {palette['background']} 56%, transparent) !important;
  --toolbar-bgcolor: transparent !important;
  --toolbar-color: {palette['foreground']} !important;
  --lwt-accent-color: color-mix(in srgb, {palette['dark_background']} 72%, transparent) !important;
  --lwt-text-color: {palette['foreground']} !important;
  --arrowpanel-background: color-mix(in srgb, {palette['lighter_background']} 88%, transparent) !important;
  --arrowpanel-color: {palette['foreground']} !important;
  --input-bgcolor: color-mix(in srgb, {palette['darker_background']} 78%, transparent) !important;
  --input-color: {palette['foreground']} !important;
  --sidebar-background-color: transparent !important;
  --sidebar-text-color: {palette['foreground']} !important;
  --tab-selected-bgcolor: color-mix(in srgb, {palette['selection']} 82%, transparent) !important;
  --toolbarbutton-icon-fill: {palette['foreground']} !important;
}}

#zen-main-app-wrapper,
#zen-appcontent-wrapper,
#zen-sidebar-splitter {{
  appearance: none !important;
  background: transparent !important;
}}

#navigator-toolbox {{
  background: color-mix(in srgb, {palette['background']} 68%, transparent) !important;
  backdrop-filter: blur(30px) saturate(145%) !important;
  -moz-backdrop-filter: blur(30px) saturate(145%) !important;
  border-color: color-mix(in srgb, {palette['accent']} 24%, transparent) !important;
  color: {palette['foreground']} !important;
}}

#TabsToolbar,
#titlebar,
#zen-tabs-wrapper,
#zen-sidebar-top-buttons,
#zen-sidebar-foot-buttons {{
  background: transparent !important;
}}

#navigator-toolbox {{
  border-right: 1px solid color-mix(in srgb, {palette['accent']} 22%, transparent) !important;
  box-shadow:
    inset -1px 0 color-mix(in srgb, {palette['foreground']} 6%, transparent),
    8px 0 28px color-mix(in srgb, {palette['darker_background']} 24%, transparent) !important;
}}

.tabbrowser-tab .tab-background {{
  background: color-mix(in srgb, {palette['foreground']} 4%, transparent) !important;
  border-radius: 10px !important;
}}

.tabbrowser-tab[selected="true"] .tab-background {{
  background: color-mix(in srgb, {palette['selection']} 82%, transparent) !important;
  box-shadow: inset 0 0 0 1px color-mix(in srgb, {palette['accent']} 18%, transparent) !important;
}}

#urlbar-background,
#searchbar {{
  background: color-mix(in srgb, {palette['darker_background']} 78%, transparent) !important;
  backdrop-filter: blur(20px) saturate(140%) !important;
  border: 1px solid color-mix(in srgb, {palette['accent']} 18%, transparent) !important;
}}
"""

profiles = configparser.ConfigParser()
profiles.read(profiles_path)
for section in profiles.sections():
    if not section.startswith("Profile") or "Path" not in profiles[section]:
        continue
    profile_path = Path(profiles[section]["Path"])
    if profiles[section].get("IsRelative", "1") == "1":
        profile_path = profiles_path.parent / profile_path
    profile_path.mkdir(parents=True, exist_ok=True)
    chrome_path = profile_path / "chrome"
    chrome_path.mkdir(exist_ok=True)
    (chrome_path / "userChrome.css").write_text(css)

    user_js_path = profile_path / "user.js"
    existing = user_js_path.read_text() if user_js_path.is_file() else ""
    start = "// BEGIN OMARCHY ZEN THEME\n"
    end = "// END OMARCHY ZEN THEME\n"
    managed = (
        start
        + 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n'
        + 'user_pref("zen.widget.linux.transparency", true);\n'
        + end
    )
    if start in existing and end in existing:
        existing = re.sub(re.escape(start) + ".*?" + re.escape(end), managed, existing, flags=re.DOTALL)
    else:
        if existing and not existing.endswith("\n"):
            existing += "\n"
        existing += managed
    user_js_path.write_text(existing)
PY
